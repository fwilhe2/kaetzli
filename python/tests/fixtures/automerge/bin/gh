#!/bin/bash
# A fake gh for the auto-merge harness: pull requests and checks from files in $FAKE.
# --jq is applied by the real jq, as gh would; the log leaves out pr list's --jq, the one
# place the two implementations ask differently for the same answer.
set -u
args=("$@") jq_expr="" logged=()
for ((i = 0; i < $#; i++)); do
    if [ "${args[i]}" = --jq ]; then jq_expr=${args[i+1]}; i=$((i + 1))
        [ "${args[0]} ${args[1]}" = "pr list" ] && continue
        logged+=(--jq "$jq_expr"); continue
    fi
    logged+=("${args[i]}")
done
echo "gh ${logged[*]}" >> "$FAKE/log"
out() { if [ -n "$jq_expr" ]; then jq -r "$jq_expr"; else cat; fi; }
case "$1 $2" in
    "pr list") out < "$FAKE/prs.json" ;;
    "pr view")
        case "$5" in
            headRefOid,statusCheckRollup) out < "$FAKE/checks.$3.json" ;;
            state,labels) out < "$FAKE/late.$3.json" ;; # just before the merge
            state) # one line per call: OPEN until GitHub has noticed the merge
                n=$(cat "$FAKE/state-calls.$3" 2>/dev/null || echo 0); echo $((n + 1)) > "$FAKE/state-calls.$3"
                s=$(sed -n "$((n + 1))p" "$FAKE/state.$3" 2>/dev/null); echo "{\"state\":\"${s:-MERGED}\"}" | out ;;
        esac ;;
    "workflow run") echo "✓ Created workflow_dispatch event for ci.yml" >&2 ;;
    *) echo "fake gh: not understood: $*" >&2; exit 99 ;;
esac
