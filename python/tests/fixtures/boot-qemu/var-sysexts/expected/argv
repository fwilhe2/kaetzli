-enable-kvm
-cpu
host
-m
2048
-smp
4
-kernel
<tmp>/img/bzImage
-drive
id=root,file=<tmp>/img/rootfs.erofs,format=raw,if=none,readonly=on
-device
virtio-blk-pci,drive=root
-drive
id=var,file=<tmp>/var.img,format=raw,if=none
-device
virtio-blk-pci,drive=var
-drive
file=<tmp>/img/extensions/podman.raw,format=raw,if=none,readonly=on,id=ext-podman
-device
virtio-blk-pci,drive=ext-podman
-drive
file=<tmp>/img/extensions/debug.raw,format=raw,if=none,readonly=on,id=ext-debug
-device
virtio-blk-pci,drive=ext-debug
-drive
file=<tmp>/img/confexts/debug.raw,format=raw,if=none,readonly=on,id=conf-debug
-device
virtio-blk-pci,drive=conf-debug
-nic
user,model=virtio-net-pci,hostfwd=tcp:127.0.0.1:2299-:22
-append
root=/dev/dm-0 ro dm-mod.create="root,,,ro,0 8 verity 1 /dev/vda /dev/vda 4096 4096 1 1 sha256 ab cd" dm-mod.waitfor=/dev/vda,/dev/vdc,/dev/vdd,/dev/vde rootfstype=erofs console=ttyS0 init=/bin/bash systemd.set_credential=login.noauth:yes systemd.set_credential_binary=ssh.authorized_keys.root:<key> systemd.mount-extra=/dev/vdb:/var:ext4:x-systemd.makefs,x-systemd.growfs systemd.machine_id=0123456789abcdef0123456789abcdef systemd.mount-extra=/dev/mapper/ext-podman:/run/extensions/podman:erofs:ro systemd.mount-extra=/dev/mapper/ext-debug:/run/extensions/debug:erofs:ro systemd.mount-extra=/dev/mapper/conf-debug:/run/confexts/debug:erofs:ro
-nographic
-no-reboot
