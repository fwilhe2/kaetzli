# The one builder image. Every package is compiled in this, and it is the only place
# apt runs — see docs/guides/build-container.md for why there used to be one image per package
# and why there isn't any more.
#
# There is no ARG for the architecture: builder/deps.txt names no
# architecture-suffixed package, because build-essential and g++ pull the right
# binutils/gcc for the host on their own. Everything here builds natively, so the image
# is built once per architecture and joined into a manifest list.
# The snapshot this image is pinned to. Two things have to be named in time, not one:
#
#   the base image   debian:sid floats — it is rebuilt continuously and a checkout from
#                    two years ago would compile against whatever sid is today. Debian
#                    publishes dated sid images for exactly this, and the digest is
#                    carried alongside the tag for the same reason every packages/*/env.sh
#                    carries a SHA256 next to a URL: a name and a hash that disagree is
#                    the thing worth catching.
#
#   apt              and this is the half that is easy to skip. Pinning the base does not
#                    pin `apt-get install`: deb.debian.org serves whatever sid holds right
#                    now, so an old base plus today's archive is a mixture, and it stops
#                    resolving at all once a package leaves sid. snapshot.debian.org keeps
#                    every version of every package forever, so the same date names the
#                    same package set.
#
# SNAPSHOT is one date and both halves follow it. tools/image-tags.sh hashes this file
# into the builder tag, so bumping the date produces a new image and a new tag with no
# other change — the same way bumping a VERSION does for a package.
#
# What this buys is a toolchain that can be *rebuilt*, which is a different guarantee from
# the one ghcr already gives. The builder image is pushed under a content-hash tag and
# pulled if it exists, so the bytes are retrievable as long as that tag and that registry
# live. Pinning the inputs means they can be regenerated without either — and it makes the
# content hash honest, since two builds of the same deps.txt now produce the same image
# instead of merely claiming to.
ARG SNAPSHOT=20261104

# Go and Rust are upstream's release tarballs, not sid's packages (builder/toolchains/,
# docs/proposals/own-toolchain.md): unpacked in a stage of their own, so the image gets the
# installed trees and not the 300 MB of tarballs. tools/prep.sh fetches them, checks each
# against its pinned SHA-256 and upstream's signature, and passes the directory as the
# `toolchain-tarballs` build context; its SHA256SUMS is checked again here, so a build
# handed the wrong files fails rather than installs them. Same base as below, so
# bump-snapshot.sh moves both FROM lines together.
FROM debian:sid-${SNAPSHOT}@sha256:e276677157e13bc51ea5b8651f54ad28883f503cc37b3e3af2c4b6cc2f4efe7b AS toolchains
COPY --from=toolchain-tarballs . /dl
# Rust's components each carry an install.sh; one prefix for all three, which rustc finds
# its standard library relative to. Its uninstaller and manifests are of no use here.
RUN cd /dl && sha256sum --check --strict SHA256SUMS \
    && tar -C /opt -xzf go*.linux-*.tar.gz \
    && for c in rustc cargo rust-std; do \
           mkdir "/tmp/$c" && tar -C "/tmp/$c" --strip-components=1 -xzf "$c"-*.tar.gz \
           && "/tmp/$c/install.sh" --prefix=/opt/rust --disable-ldconfig >/dev/null \
           || exit 1; \
       done \
    && rm -rf /opt/rust/share/doc /opt/rust/lib/rustlib/uninstall.sh /opt/rust/lib/rustlib/manifest-* \
    && /opt/go/bin/go version && /opt/rust/bin/rustc --version && /opt/rust/bin/cargo --version

FROM debian:sid-${SNAPSHOT}@sha256:e276677157e13bc51ea5b8651f54ad28883f503cc37b3e3af2c4b6cc2f4efe7b

# FROM consumed the outer ARG; redeclare it to use it in the build stage.
ARG SNAPSHOT

COPY builder/deps.txt /deps.txt

# Point apt at the snapshot before it is first run. Recent Debian images ship the deb822
# /etc/apt/sources.list.d/debian.sources, so that is what has to go — leaving it behind
# would mean apt reading the live archive and the snapshot at once.
#
# http, not https, deliberately: the base image has no ca-certificates and apt's integrity
# does not come from TLS anyway — it comes from the signature on the Release file, which
# is checked either way. check-valid-until=no is not optional, because a snapshot's Release
# file is stale by construction and apt refuses stale metadata by default.
# The retries are for snapshot.debian.org, which answers 503 (TooManyRequests) and 504
# under load, as image/Containerfile has it: apt backs off between them. Without them one
# refused package of the ~200 here failed the whole builder job.
RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%sT000000Z sid main\n' "$SNAPSHOT" \
       > /etc/apt/sources.list \
    && printf 'Acquire::Retries "10";\n' > /etc/apt/apt.conf.d/80-retries

# One layer, so the image has one apt transaction in its history rather than 23. The sed
# strips comments and blank lines; xargs turns what is left into the argument list.
#
# The packages go through /debs. tools/prep.sh bind-mounts a directory there, seeded
# from the last build's (the builder-debs image): apt takes a file from it when its
# SHA-256 is the one the snapshot's signed index names, and downloads the rest, so
# snapshot.debian.org is asked for only what is new, and a failed attempt's downloads
# are kept for the next. Without a mount, /debs is a plain directory, removed again.
RUN apt-get update \
    && mkdir -p /debs \
    && sed -e 's/#.*//' -e '/^[[:space:]]*$/d' /deps.txt \
       | xargs apt-get -o Dir::Cache::Archives=/debs -o APT::Keep-Downloaded-Packages=true \
           install -y --no-install-recommends \
    && rm -rf /var/lib/apt/lists/* \
    && rm -rf /debs/partial \
    && if ! mountpoint -q /debs; then rm -rf /debs; fi

COPY --from=toolchains /opt/go /opt/go
COPY --from=toolchains /opt/rust /opt/rust
ENV PATH=/opt/go/bin:/opt/rust/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

COPY builder/build-package.sh /build.sh
RUN chmod +x /build.sh

WORKDIR /usr/local/src
