From d6b778ced7795ace1e91f18f59f6dd61e94c5580 Mon Sep 17 00:00:00 2001
From: Rasmus Villemoes <rv@rasmusvillemoes.dk>
Date: Fri, 16 Oct 2026 13:23:04 +0200
Subject: [PATCH] doc/extend.texi: fix fclose -> pclose typo in malloc
 attribute example

This was correct initially, but got accidentally changed to fclose by
commit cf6a4fbbaf9 ("doc: Switch some attribute examples to using
standard syntax [PR102397]").

gcc/ChangeLog:

	* doc/extend.texi (Common Attributes): Fix typo in example.
---
 gcc/doc/extend.texi | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/gcc/doc/extend.texi b/gcc/doc/extend.texi
index a44e7965b90a..5b25bfde4a90 100644
--- a/gcc/doc/extend.texi
+++ b/gcc/doc/extend.texi
@@ -3357,7 +3357,7 @@ int pclose (FILE*);
   FILE* fopen (const char*, const char*);
 [[gnu::malloc, gnu::malloc (fclose, 1)]]
   FILE* fmemopen(void *, size_t, const char *);
-[[gnu::malloc, gnu::malloc (fclose, 1)]]
+[[gnu::malloc, gnu::malloc (pclose, 1)]]
   FILE* popen (const char*, const char*);
 [[gnu::malloc, gnu::malloc (fclose, 1)]]
   FILE* tmpfile (void);
