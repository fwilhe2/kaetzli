-      if (_M_search_mode == _Search_mode::_BFS)
+      if constexpr (__search_mode == _Search_mode::_Bfs)
 	if (_M_visited(__i))
 	  return _S_invalid_state_id;
 
@@ -622,12 +628,12 @@ namespace __detail
       switch (_M_nfa[__i]._M_opcode())
 	{
