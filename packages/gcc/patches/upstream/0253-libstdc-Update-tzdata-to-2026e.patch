From f693411bc2eb2e03bac32e1df5a8d661a468234f Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Tomasz=20Kami=C5=84ski?= <tkaminsk@redhat.com>
Date: Wed, 7 Oct 2026 12:03:45 +0200
Subject: [PATCH] libstdc++: Update tzdata to 2026e

Import the new 2026e tzdata.zi file and new leapseconds expiry date.

libstdc++-v3/ChangeLog:

	* include/std/chrono (chrono::__detail::__get_leap_second_info):
	Update expiry date for leap seconds list.
	* src/c++20/tzdb.cc (chrono::<unnamed>::fixed_expiry): Likewise.
	* src/c++20/tzdata.zi: Import new file from 2026e release.

Reviewed-by: Jonathan Wakely <jwakely@redhat.com>
(cherry picked from commit 080bfd8da2e572dab240cce4a685b342fa7c070d)
---
 libstdc++-v3/include/std/chrono  |   2 +-
 libstdc++-v3/src/c++20/tzdata.zi | 189 +++++++------------------------
 libstdc++-v3/src/c++20/tzdb.cc   |   4 +-
 3 files changed, 46 insertions(+), 149 deletions(-)

diff --git a/libstdc++-v3/include/std/chrono b/libstdc++-v3/include/std/chrono
index 692fd6025e7d..35d023ddaf57 100644
--- a/libstdc++-v3/include/std/chrono
+++ b/libstdc++-v3/include/std/chrono
@@ -3270,7 +3270,7 @@ namespace __detail
 
       // The list above is known to be valid until (at least) this date
       // and only contains positive leap seconds.
-      constexpr sys_seconds __expires(1798416000s); // 2026-12-28 00:00:00 UTC
+      constexpr sys_seconds __expires(1814140800s); // 2027-06-28 00:00:00 UTC
 
       if (__ss > __expires)
 	{
