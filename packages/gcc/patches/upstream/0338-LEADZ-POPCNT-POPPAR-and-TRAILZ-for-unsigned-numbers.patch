 gcc/testsuite/gfortran.dg/unsigned_45.f90 | 67 +++++++++++++++++++++++
 4 files changed, 77 insertions(+), 6 deletions(-)
 create mode 100644 gcc/testsuite/gfortran.dg/unsigned_45.f90

