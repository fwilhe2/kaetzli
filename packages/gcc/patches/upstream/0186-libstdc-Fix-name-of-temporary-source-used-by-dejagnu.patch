From 6fbd6d7739806031d0da05233f1fa20683cb4723 Mon Sep 17 00:00:00 2001
From: Jonathan Wakely <jwakely@redhat.com>
Date: Thu, 17 Sep 2026 19:05:00 +0100
Subject: [PATCH] libstdc++: Fix name of temporary source used by dejagnu
 checks

The v3_check_preprocessor_condition proc takes an argument to use as the
filename, but was then passing it to v3_try_preprocess as the literal
string 'name' instead of using the variable, $name.

libstdc++-v3/ChangeLog:

	* testsuite/lib/libstdc++.exp (v3_check_preprocessor_condition):
	Use argument as filename for preprocessing.

(cherry picked from commit 6e53e027e587600b914793d79618b61131681862)
---
 libstdc++-v3/testsuite/lib/libstdc++.exp | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/libstdc++-v3/testsuite/lib/libstdc++.exp b/libstdc++-v3/testsuite/lib/libstdc++.exp
index 4124e3e87670..661731d7bf75 100644
--- a/libstdc++-v3/testsuite/lib/libstdc++.exp
+++ b/libstdc++-v3/testsuite/lib/libstdc++.exp
@@ -1173,7 +1173,7 @@ proc v3_check_preprocessor_condition { name cond { inc "" } } {
 	"
     set flags "$cxxflags $DEFAULT_CXXFLAGS -Werror"
 
-    return [v3_try_preprocess name $code $flags]
+    return [v3_try_preprocess $name $code $flags]
 }
 
 # Return 1 if libstdc++ defines macro for the current target, 0 otherwise.
