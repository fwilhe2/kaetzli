From 04a71db17257f5e61efacc1e9a01f5f2cc2face6 Mon Sep 17 00:00:00 2001
From: Avinash Jayakar <avinashd@linux.ibm.com>
Date: Mon, 2 Nov 2026 14:08:33 +0530
Subject: [PATCH] rs6000: Use signed integers when resolving
 __builtin_ppc_atomic_cas_local

The __builtin_ppc_atomic_cas_local builtin was incorrectly casting
pointer arguments to unsigned integer types in the overload
resolution handler, while the actual builtin definitions expected
signed types. This caused C++ compilation to fail with "invalid
conversion" errors due to C++'s stricter type checking, while C
compilation succeeded due to its more permissive pointer
conversion rules.

The fix changes the intermediate casting types in rs6000-c.cc to
use signed types that match the builtin signatures in
rs6000-builtins.def.

This patch also adds cc and cpp extensions to powerpc.exp to accept
c++ tests.

2026-11-05  Avinash Jayakar  <avinashd@linux.ibm.com>

gcc/ChangeLog:
	* config/rs6000/rs6000-c.cc (altivec_resolve_overloaded_builtin): Use
	signed types intead of unsigned for atomic_cas_local builtin casts.

gcc/testsuite/ChangeLog:
	* gcc.target/powerpc/acmp-tst.cc: New test.
	* gcc.target/powerpc/acmp-tst-32bit.cc: New test.
	* gcc.target/powerpc/acmp-tst-indexed.cc: New test.
	* gcc.target/powerpc/powerpc.exp: Accept c++ tests.

(cherry picked from commit 2175b27369e5104c124c275e5681260f10c20edc)
---
 gcc/config/rs6000/rs6000-c.cc                 |  10 +-
 .../gcc.target/powerpc/acmp-tst-32bit.cc      |  61 ++++++
 .../gcc.target/powerpc/acmp-tst-indexed.cc    | 165 ++++++++++++++++
 gcc/testsuite/gcc.target/powerpc/acmp-tst.cc  | 176 ++++++++++++++++++
 gcc/testsuite/gcc.target/powerpc/powerpc.exp  |   2 +-
 5 files changed, 408 insertions(+), 6 deletions(-)
 create mode 100644 gcc/testsuite/gcc.target/powerpc/acmp-tst-32bit.cc
 create mode 100644 gcc/testsuite/gcc.target/powerpc/acmp-tst-indexed.cc
 create mode 100644 gcc/testsuite/gcc.target/powerpc/acmp-tst.cc

diff --git a/gcc/config/rs6000/rs6000-c.cc b/gcc/config/rs6000/rs6000-c.cc
index 4984ec1c35a6..0665d267121d 100644
--- a/gcc/config/rs6000/rs6000-c.cc
+++ b/gcc/config/rs6000/rs6000-c.cc
@@ -1792,19 +1792,19 @@ altivec_resolve_overloaded_builtin (location_t loc, tree fndecl,
 	{
 	case 1:
 	  target_fcode = RS6000_BIF_PPC_ATOMIC_CAS_QI;
-	  int_type = unsigned_char_type_node;
+	  int_type = signed_char_type_node;
 	  break;
 	case 2:
 	  target_fcode = RS6000_BIF_PPC_ATOMIC_CAS_HI;
-	  int_type = short_unsigned_type_node;
+	  int_type = short_integer_type_node;
 	  break;
 	case 4:
 	  target_fcode = RS6000_BIF_PPC_ATOMIC_CAS_SI;
-	  int_type = unsigned_intSI_type_node;
+	  int_type = intSI_type_node;
 	  break;
 	case 8:
 	  target_fcode = RS6000_BIF_PPC_ATOMIC_CAS_DI;
-	  int_type = long_long_unsigned_type_node;
+	  int_type = long_long_integer_type_node;
 	  break;
 	case 16:
 	  if (!TARGET_QUAD_MEMORY_ATOMIC)
@@ -1815,7 +1815,7 @@ altivec_resolve_overloaded_builtin (location_t loc, tree fndecl,
 	      return error_mark_node;
 	    }
 	  target_fcode = RS6000_BIF_PPC_ATOMIC_CAS_TI;
-	  int_type = unsigned_intTI_type_node;
+	  int_type = intTI_type_node;
 	  break;
 	default:
 	  if (complain)
diff --git a/gcc/testsuite/gcc.target/powerpc/acmp-tst-32bit.cc b/gcc/testsuite/gcc.target/powerpc/acmp-tst-32bit.cc
new file mode 100644
index 000000000000..79f646a4f274
--- /dev/null
+++ b/gcc/testsuite/gcc.target/powerpc/acmp-tst-32bit.cc
@@ -0,0 +1,61 @@
+/* { dg-do compile } */
+/* { dg-require-effective-target ilp32 } */
+
+/* { dg-options "-O2 -mdejagnu-cpu=power8" } */
+
+bool
+word_exchange_qi (signed char *ptr, signed char *expected, signed char *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+bool
+word_exchange_uqi (unsigned char *ptr, unsigned char *expected,
+                   unsigned char *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+bool
+word_exchange_hi (short *ptr, short *expected, short *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+bool
+word_exchange_shi (signed short *ptr, signed short *expected,
+                   signed short *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+bool
+word_exchange_uhi (unsigned short *ptr, unsigned short *expected,
+                   unsigned short *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+bool
+word_exchange_si (int *ptr, int *expected, int *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+bool
+word_exchange_ssi (signed int *ptr, signed int *expected, signed int *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+bool
+word_exchange_usi (unsigned int *ptr, unsigned int *expected,
+                   unsigned int *desired)
+{
+  return __builtin_ppc_atomic_cas_local (ptr, expected, desired, 0,
+					 __ATOMIC_SEQ_CST, __ATOMIC_ACQUIRE);
+}
+
+/* { dg-final { scan-assembler-times {\mlbarx +[0-9]+,[0-9]+,[0-9]+,1} 2 } } */
+/* { dg-final { scan-assembler-times {\mlharx +[0-9]+,[0-9]+,[0-9]+,1} 3 } } */
+/* { dg-final { scan-assembler-times {\mlwarx +[0-9]+,[0-9]+,[0-9]+,1} 3 } } */
