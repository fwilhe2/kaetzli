+++ b/gcc/testsuite/gcc.target/riscv/rvv/autovec/ternop/pr126932.c
@@ -0,0 +1,55 @@
+/* { dg-do compile } */
+/* { dg-options "-O3 -march=rv64gcv -mabi=lp64d -ffp-contract=off" } */
+/* { dg-require-effective-target rv64 } */
+
+typedef struct { float x, y, z, w; } vec4;
+
+vec4 mul_add(vec4 a, vec4 b, vec4 c)
+{
+  vec4 v;
+  v.x = a.x + b.x * c.x;
+  v.y = a.y + b.y * c.y;
+  v.z = a.z + b.z * c.z;
+  v.w = a.w + b.w * c.w;
+  return v;
+}
+
+vec4 neg_mul_add(vec4 a, vec4 b, vec4 c)
+{
+  vec4 v;
+  v.x = c.x - a.x * b.x;
+  v.y = c.y - a.y * b.y;
+  v.z = c.z - a.z * b.z;
+  v.w = c.w - a.w * b.w;
+  return v;
+}
+
+vec4 mul_sub(vec4 a, vec4 b, vec4 c)
+{
+  vec4 v;
+  v.x = a.x * b.x - c.x;
+  v.y = a.y * b.y - c.y;
+  v.z = a.z * b.z - c.z;
+  v.w = a.w * b.w - c.w;
+  return v;
+}
+
+vec4 neg_mul_sub(vec4 a, vec4 b, vec4 c)
+{
+  vec4 v;
+  v.x = -(a.x * b.x) - c.x;
+  v.y = -(a.y * b.y) - c.y;
+  v.z = -(a.z * b.z) - c.z;
+  v.w = -(a.w * b.w) - c.w;
+  return v;
+}
+
