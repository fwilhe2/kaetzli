diff --git a/gcc/testsuite/gcc.dg/pr127848-1.c b/gcc/testsuite/gcc.dg/pr127848-1.c
new file mode 100644
index 000000000000..8d3a3e88751f
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/pr127848-1.c
@@ -0,0 +1,8 @@
+/* PR middle-end/127848 */
+/* { dg-do compile { target bitint } } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+/* For bitint_ext_undef targets, tail call is definitely wrong-code, bit 15 is unspecified from foo and needs to be cleared in bar.  */
+/* { dg-final { scan-tree-dump-not "= foo \\\(\\\); \\\[tail call\\\]" "optimized" { target i?86-*-* x86_64*-*-* aarch64*-*-* powerpc*-*-* } } } */
+
+unsigned _BitInt(15) foo ();
+unsigned short bar () { return foo (); }
diff --git a/gcc/testsuite/gcc.dg/pr127848-2.c b/gcc/testsuite/gcc.dg/pr127848-2.c
new file mode 100644
index 000000000000..518986da3af0
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/pr127848-2.c
@@ -0,0 +1,18 @@
+/* PR middle-end/127848 */
+/* { dg-do compile { target bitint } } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+/* For bitint_ext_undef targets, narrowing or same precision _BitInt conversion within the same mode and size is ok.  */
+/* { dg-final { scan-tree-dump-times "= foo \\\(\\\); \\\[tail call\\\]" 3 "optimized" { target i?86-*-* x86_64*-*-* aarch64*-*-* powerpc*-*-* } } } */
+/* { dg-final { scan-tree-dump-times "= qux \\\(\\\); \\\[tail call\\\]" 3 "optimized" { target i?86-*-* x86_64*-*-* aarch64*-*-* powerpc*-*-* } } } */
+/* For bitint_ext_full targets, such conversions are definitely not ok.  In these cases even on bitint_ext_partial.  */
+/* { dg-final { scan-tree-dump-not "= foo \\\(\\\); \\\[tail call\\\]" "optimized" { target arm*-*-* riscv*-*-* s390*-*-* loongarch*-*-* } } } */
+/* { dg-final { scan-tree-dump-not "= qux \\\(\\\); \\\[tail call\\\]" "optimized" { target arm*-*-* riscv*-*-* s390*-*-* loongarch*-*-* } } } */
+
+unsigned _BitInt(15) foo ();
+[[gnu::noipa]] unsigned _BitInt(13) bar () { return foo (); }
+[[gnu::noipa]] signed _BitInt(13) baz () { return foo (); }
+[[gnu::noipa]] signed _BitInt(15) corge () { return foo (); }
+signed _BitInt(15) qux ();
+[[gnu::noipa]] signed _BitInt(13) fred () { return qux (); }
+[[gnu::noipa]] unsigned _BitInt(13) waldo () { return qux (); }
+[[gnu::noipa]] unsigned _BitInt(13) xyzzy () { return qux (); }
diff --git a/gcc/testsuite/gcc.dg/pr127848-3.c b/gcc/testsuite/gcc.dg/pr127848-3.c
new file mode 100644
index 000000000000..ac5125d8acbc
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/pr127848-3.c
@@ -0,0 +1,18 @@
+/* PR middle-end/127848 */
+/* { dg-do compile { target bitint } } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+/* For bitint_ext_undef targets, narrowing or same precision _BitInt conversion within the same mode and size is ok.  */
+/* { dg-final { scan-tree-dump-times "= foo \\\(\\\); \\\[tail call\\\]" 3 "optimized" { target i?86-*-* x86_64*-*-* aarch64*-*-* powerpc*-*-* } } } */
+/* { dg-final { scan-tree-dump-times "= qux \\\(\\\); \\\[tail call\\\]" 3 "optimized" { target i?86-*-* x86_64*-*-* aarch64*-*-* powerpc*-*-* } } } */
+/* For bitint_ext_full targets, such conversions are definitely not ok.  In these cases even on bitint_ext_partial.  */
+/* { dg-final { scan-tree-dump-not "= foo \\\(\\\); \\\[tail call\\\]" "optimized" { target arm*-*-* riscv*-*-* s390*-*-* loongarch*-*-* } } } */
+/* { dg-final { scan-tree-dump-not "= qux \\\(\\\); \\\[tail call\\\]" "optimized" { target arm*-*-* riscv*-*-* s390*-*-* loongarch*-*-* } } } */
+
+unsigned _BitInt(31) foo ();
+[[gnu::noipa]] unsigned _BitInt(25) bar () { return foo (); }
+[[gnu::noipa]] signed _BitInt(25) baz () { return foo (); }
+[[gnu::noipa]] signed _BitInt(31) corge () { return foo (); }
+signed _BitInt(31) qux ();
+[[gnu::noipa]] signed _BitInt(25) fred () { return qux (); }
+[[gnu::noipa]] unsigned _BitInt(25) waldo () { return qux (); }
+[[gnu::noipa]] unsigned _BitInt(25) xyzzy () { return qux (); }
diff --git a/gcc/testsuite/gcc.dg/pr127848-4.c b/gcc/testsuite/gcc.dg/pr127848-4.c
new file mode 100644
index 000000000000..16ad7e287ea9
--- /dev/null
+++ b/gcc/testsuite/gcc.dg/pr127848-4.c
@@ -0,0 +1,20 @@
+/* PR middle-end/127848 */
+/* { dg-do compile { target bitint } } */
+/* { dg-options "-O2 -fdump-tree-optimized" } */
+/* For bitint_ext_undef targets, widening precision _BitInt conversion are not ok.  */
+/* For bitint_ext_full targets, widening precisions with the same size are ok if the sign is the same.  */
+/* { dg-final { scan-tree-dump-not "= foo \\\(\\\); \\\[tail call\\\]" "optimized" { target i?86-*-* x86_64*-*-* aarch64*-*-* powerpc*-*-* } } } */
+/* { dg-final { scan-tree-dump-not "= baz \\\(\\\); \\\[tail call\\\]" "optimized" { target i?86-*-* x86_64*-*-* aarch64*-*-* powerpc*-*-* } } } */
