From 010d21bec0be3cb0383bea3c49c0ba9daadc5cc5 Mon Sep 17 00:00:00 2001
From: Eric Botcazou <ebotcazou@adacore.com>
Date: Thu, 26 Nov 2026 22:33:54 +0100
Subject: [PATCH] Ada: Fix wrong resolution for iterated expression of
 aggregate in instance

This is a regression present on the mainline, 16 and 15 branches: the global
names present in the expression of an iterated component association inside
an aggregate are incorrectly resolved in instances of a generic unit.

This was fixed under PR ada/128723 in some contexts but not in all of them,
because the global resolution performed in the generic unit may subsequently
be dropped in the instance.

gcc/ada/
	PR ada/128723
	PR ada/129058
	* sem_aggr.adb (Resolve_Array_Aggregate.Resolve_Aggr_Expr):
	Copy the expression by means of New_Copy_Tree.
	(Resolve_Delta_Array_Aggregate): Likewise.

gcc/testsuite/
	* gnat.dg/specs/aggr13.ads: New test.
	* gnat.dg/specs/aggr13_pkg.ads: New helper.
---
 gcc/ada/sem_aggr.adb                       |  4 ++--
 gcc/testsuite/gnat.dg/specs/aggr13.ads     |  7 +++++++
 gcc/testsuite/gnat.dg/specs/aggr13_pkg.ads | 10 ++++++++++
 3 files changed, 19 insertions(+), 2 deletions(-)
 create mode 100644 gcc/testsuite/gnat.dg/specs/aggr13.ads
 create mode 100644 gcc/testsuite/gnat.dg/specs/aggr13_pkg.ads

diff --git a/gcc/ada/sem_aggr.adb b/gcc/ada/sem_aggr.adb
index d2964b9426ac..b6d7ad14388a 100644
--- a/gcc/ada/sem_aggr.adb
+++ b/gcc/ada/sem_aggr.adb
@@ -2080,7 +2080,7 @@ package body Sem_Aggr is
                   In_Assoc : constant Boolean :=
                     Nkind (Parent (Expr)) in N_Component_Association
                                            | N_Iterated_Component_Association;
-                  New_Expr : constant Node_Id := Copy_Separate_Tree (Expr);
+                  New_Expr : constant Node_Id := New_Copy_Tree (Expr);
 
                begin
                   Set_Parent (New_Expr, Parent (Expr));
@@ -4527,7 +4527,7 @@ package body Sem_Aggr is
                if Inside_A_Generic then
                   Expr := Expression (Assoc);
                else
-                  Expr := Copy_Separate_Tree (Expression (Assoc));
+                  Expr := New_Copy_Tree (Expression (Assoc));
                end if;
                Set_Parent (Expr, Assoc);
                Preanalyze_And_Resolve (Expr, Component_Type (Typ));
diff --git a/gcc/testsuite/gnat.dg/specs/aggr13.ads b/gcc/testsuite/gnat.dg/specs/aggr13.ads
new file mode 100644
index 000000000000..b4797faa4005
--- /dev/null
+++ b/gcc/testsuite/gnat.dg/specs/aggr13.ads
@@ -0,0 +1,7 @@
+-- PR ada/129058
+-- { dg-do compile }
+-- { dg-options "-gnat2022" }
+
+with Aggr13_Pkg;
+
+package Aggr13 is new Aggr13_Pkg;
diff --git a/gcc/testsuite/gnat.dg/specs/aggr13_pkg.ads b/gcc/testsuite/gnat.dg/specs/aggr13_pkg.ads
new file mode 100644
index 000000000000..cdf39c9dd9f0
--- /dev/null
+++ b/gcc/testsuite/gnat.dg/specs/aggr13_pkg.ads
@@ -0,0 +1,10 @@
+-- { dg-options "-gnat2022" }
+
+with Ada.Strings.Unbounded;
+
+generic
+package Aggr13_Pkg is
+   type Arr is array (1 .. 3) of Ada.Strings.Unbounded.Unbounded_String;
+   A : constant Arr :=
+     [for I in Arr'Range => Ada.Strings.Unbounded.To_Unbounded_String ("x")];
+end Aggr13_Pkg;
