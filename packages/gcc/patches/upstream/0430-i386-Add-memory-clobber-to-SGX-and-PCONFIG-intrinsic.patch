From 0dc852fcc1ab62de19b4f9ceae763f60ce9a54d8 Mon Sep 17 00:00:00 2001
From: Uros Bizjak <ubizjak@gmail.com>
Date: Mon, 2 Nov 2026 22:05:48 +0100
Subject: [PATCH] i386: Add "memory" clobber to SGX and PCONFIG intrinsics
 [PR128283]

The ENCLS, ENCLU, ENCLV and PCONFIG inline asm wrappers pass pointers
to buffers in general registers, but do not declare that the
instructions access memory.  As a result, DSE can remove stores that
initialize the input structures and FRE can fold loads from the output
buffers.  Add "memory" to the clobber list of all of them.

Also add the missing "cc" clobber to __encls_edbgrd, since EDBGRD
modifies the status flags, and remove the superfluous "\n\t" from the
end of the asm templates.

	PR target/128283

gcc/ChangeLog:

	* config/i386/sgxintrin.h (__encls_bc, __encls_bcd, __encls_c)
	(__encls_edbgrd, __encls_generic, __enclu_bc, __enclu_bcd)
	(__enclu_eenter, __enclu_eexit, __enclu_generic, __enclv_bc)
	(__enclv_cd, __enclv_generic): Add "memory" clobber.
	Remove "\n\t" from asm template.
	(__encls_edbgrd): Also add "cc" clobber.
	* config/i386/pconfigintrin.h (__pconfig_b, __pconfig_generic):
	Add "memory" clobber.  Remove "\n\t" from asm template.

gcc/testsuite/ChangeLog:

	* gcc.target/i386/pr128283-1.c: New test.
	* gcc.target/i386/pr128283-2.c: Ditto.

(cherry picked from commit 79cd72f94d73ccc5095a9291c10a32b9965d0f77)
---
 gcc/config/i386/pconfigintrin.h            |  8 ++--
 gcc/config/i386/sgxintrin.h                | 53 +++++++++++-----------
 gcc/testsuite/gcc.target/i386/pr128283-1.c | 18 ++++++++
 gcc/testsuite/gcc.target/i386/pr128283-2.c | 24 ++++++++++
 4 files changed, 73 insertions(+), 30 deletions(-)
 create mode 100644 gcc/testsuite/gcc.target/i386/pr128283-1.c
 create mode 100644 gcc/testsuite/gcc.target/i386/pr128283-2.c

diff --git a/gcc/config/i386/pconfigintrin.h b/gcc/config/i386/pconfigintrin.h
index e3ff36e62b5e..33ef551660df 100644
--- a/gcc/config/i386/pconfigintrin.h
+++ b/gcc/config/i386/pconfigintrin.h
@@ -35,16 +35,16 @@
 #endif /* __PCONFIG__ */
 
 #define __pconfig_b(leaf, b, retval)			\
-  __asm__ __volatile__ ("pconfig\n\t"			\
+  __asm__ __volatile__ ("pconfig"			\
 	: "=a" (retval)					\
 	: "a" (leaf), "b" (b)				\
-	: "cc")
+	: "cc", "memory")
 
 #define __pconfig_generic(leaf, b, c, d, retval)	\
-  __asm__ __volatile__ ("pconfig\n\t"			\
+  __asm__ __volatile__ ("pconfig"			\
 	: "=a" (retval), "=b" (b), "=c" (c), "=d" (d)	\
 	: "a" (leaf), "b" (b), "c" (c), "d" (d)		\
-	: "cc")
+	: "cc", "memory")
 
 extern __inline unsigned int
 __attribute__((__gnu_inline__, __always_inline__, __artificial__))
