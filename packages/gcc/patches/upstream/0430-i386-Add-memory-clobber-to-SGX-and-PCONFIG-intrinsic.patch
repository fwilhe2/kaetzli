diff --git a/gcc/testsuite/gcc.target/i386/pr128283-1.c b/gcc/testsuite/gcc.target/i386/pr128283-1.c
new file mode 100644
index 000000000000..2f0a8b29a2cd
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/pr128283-1.c
@@ -0,0 +1,18 @@
+/* PR target/128283 */
+/* { dg-do compile } */
+/* { dg-options "-O2 -msgx -fdump-tree-optimized" } */
+
+#include <immintrin.h>
+#include <stdint.h>
+
+uint64_t
+derive_sgx_key (uint64_t *req_aligned)
+{
+  uint64_t key[2] __attribute__((aligned(16))) = {0, 0};
+  size_t d[3] = {(size_t)req_aligned, (size_t)key, 0};
+
+  _enclu_u32(1 /* EGETKEY */, d);
+  return key[0];
+}
+
+/* { dg-final { scan-tree-dump " = key\\\[0\\\];" "optimized" } } */
diff --git a/gcc/testsuite/gcc.target/i386/pr128283-2.c b/gcc/testsuite/gcc.target/i386/pr128283-2.c
new file mode 100644
index 000000000000..65f1b5c182bb
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/pr128283-2.c
@@ -0,0 +1,24 @@
+/* PR target/128283 */
+/* { dg-do compile } */
+/* { dg-options "-O2 -mpconfig -fdump-tree-optimized" } */
+
+#include <immintrin.h>
+#include <stdint.h>
+
+struct mktme_kp
+{
+  uint16_t keyid;
+  uint32_t ctrl;
+  uint8_t pad[186];
+} __attribute__((aligned(256)));
+
+unsigned int
+program_mktme (uint16_t kid)
+{
+  struct mktme_kp kp = { .keyid = kid, .ctrl = 1 };
+  size_t d[3] = { (size_t) &kp, 0, 0 };
+
+  return _pconfig_u32 (0 /* MKTME_KEY_PROGRAM */, d);
+}
+
+/* { dg-final { scan-tree-dump "kp.ctrl = 1;" "optimized" } } */
