From 0bd3073f463141e920db6c7eaeb763c223c37bac Mon Sep 17 00:00:00 2001
From: Georg-Johann Lay <avr@gjlay.de>
Date: Mon, 24 Aug 2026 09:15:40 +0200
Subject: [PATCH] AVR: target/127024 - Fix build warning: skipping two-word
 instruction

When __AVR_ERRATA_SKIP_JMP_CALL__ is defined, then XJMP and XCALL
instructions should not be skipped due to a core erratum.

libgcc/config/avr/libf7/
	PR target/127024
	* libf7-asm.sx (to_integer): Don't skip XJMP
	if __AVR_ERRATA_SKIP_JMP_CALL__.

(cherry picked from commit 1ccae7a1e120812d4a460a6d315116d8d243648e)
---
 libgcc/config/avr/libf7/libf7-asm.sx | 13 +++++++++++--
 1 file changed, 11 insertions(+), 2 deletions(-)

diff --git a/libgcc/config/avr/libf7/libf7-asm.sx b/libgcc/config/avr/libf7/libf7-asm.sx
index c5040fd14cfe..f96c2a73d58b 100644
--- a/libgcc/config/avr/libf7/libf7-asm.sx
+++ b/libgcc/config/avr/libf7/libf7-asm.sx
@@ -602,12 +602,21 @@ DEFUN to_integer
     brmi    .Lsaturate.T    ;   > INTxx_MAX  =>  saturate
 
     brtc 9f                 ;   >= 0         =>  return
+#ifdef __AVR_ERRATA_SKIP_JMP_CALL__
+    ;; Some cores have a problem skipping 2-word instructions.
+    sbrs    Mask,   5
+    rjmp    0f
+    XJMP    __negdi2
+0:  sbrs    Mask,   4
+    rjmp    1f
+    XJMP    __negsi2
+1:
+#else
     sbrc    Mask,   5
-    .global __negdi2
     XJMP    __negdi2
     sbrc    Mask,   4
-    .global __negsi2
     XJMP    __negsi2
+#endif /* __AVR_ERRATA_SKIP_JMP_CALL__ */
     neg     C6
     neg     C5
     sbci    C6,     0
