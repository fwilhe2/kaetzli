+         ConfigureFilter (eb) ;
          JoinSentances (eb, GetSpellHint (sym[bol]))
       END
    END
@@ -2012,6 +2045,36 @@ BEGIN
 END FilterOnDefinitionModule ;
 
 
+(*
+   FilterOnType -
+*)
+
