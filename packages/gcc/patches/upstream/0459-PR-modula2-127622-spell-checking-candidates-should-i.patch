+(*
+   ConfigureFilter -
+*)
+
+PROCEDURE ConfigureFilter (eb: errorBlock) ;
+BEGIN
+   IF eb.filterType
+   THEN
+      FilterType
+   END ;
+   IF eb.filterVar
+   THEN
+      FilterVariable
+   END ;
+   IF eb.filterConst
+   THEN
+      FilterConst
+   END
+END ConfigureFilter ;
+
+
