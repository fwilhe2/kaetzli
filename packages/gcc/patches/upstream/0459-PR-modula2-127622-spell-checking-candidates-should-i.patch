diff --git a/gcc/testsuite/gm2.dg/spell/iso/fail/badspelltype.mod b/gcc/testsuite/gm2.dg/spell/iso/fail/badspelltype.mod
new file mode 100644
index 000000000000..28708c638f41
--- /dev/null
+++ b/gcc/testsuite/gm2.dg/spell/iso/fail/badspelltype.mod
@@ -0,0 +1,15 @@
+
+(* { dg-do compile } *)
+(* { dg-options "-g -c" } *)
+
+MODULE badspelltype ;
+
+VAR
+   a: CARDINAL ;
+   b: CARDINAl ;
+ (* { dg-error "unknown symbol 'CARDINAl', did you mean CARDINAL" "CARDINAl" { target *-*-* } 9 } *)
+BEGIN
+   IF a = b
+   THEN
+   END
+END badspelltype.
