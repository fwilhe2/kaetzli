diff --git a/gcc/testsuite/gcc.target/i386/pr127965-2.c b/gcc/testsuite/gcc.target/i386/pr127965-2.c
new file mode 100644
index 000000000000..2e99d3a16371
--- /dev/null
+++ b/gcc/testsuite/gcc.target/i386/pr127965-2.c
@@ -0,0 +1,16 @@
+/* PR tree-optimization/127965 */
+/* { dg-do compile { target bitint } } */
+/* { dg-options "-O2 -masm=att" } */
+
+int x = 0x20;
+
+void
+foo ()
+{
+  int v = __atomic_fetch_or (&x, 0x20, __ATOMIC_SEQ_CST);
+  if ((_BitInt (6)) v >= 0)
