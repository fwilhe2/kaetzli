 .../gcc.target/aarch64/sve/cond_fms.c         | 37 +++++++++++++++++++
 .../gcc.target/aarch64/sve/cond_fnma.c        | 37 +++++++++++++++++++
 .../gcc.target/aarch64/sve/cond_fnms.c        | 37 +++++++++++++++++++
