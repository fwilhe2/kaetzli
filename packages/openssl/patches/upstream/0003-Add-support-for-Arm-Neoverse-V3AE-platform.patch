From b108e866388f32a4d0a1ae71d176035426ac8b2a Mon Sep 17 00:00:00 2001
From: Gowtham Suresh Kumar <gowtham.sureshkumar@arm.com>
Date: Thu, 30 Jul 2026 16:10:34 +0100
Subject: [PATCH] Add support for Arm Neoverse V3AE platform

Add cpu MIDR and ensure relevant optimisations are enabled.

Backport of commit 32ff0eb from master branch.

Signed-off-by: Paul Elliott <paul.elliott@arm.com>
Signed-off-by: Gowtham Suresh Kumar <gowtham.sureshkumar@arm.com>
Reviewed-by: Tom Cosgrove <tom.cosgrove@arm.com>
Reviewed-by: Daniel Kubec <kubec@openssl.foundation>
Reviewed-by: Matt Caswell <matt@openssl.foundation>
Merge-date: Tue Sep 29 16:59:13 2026
Merged-from: https://github.com/openssl/openssl/pull/32125
---
 crypto/arm_arch.h | 1 +
 crypto/armcap.c   | 2 ++
 2 files changed, 3 insertions(+)

diff --git a/crypto/arm_arch.h b/crypto/arm_arch.h
index 9960ef3818ec..902982e44d0a 100644
--- a/crypto/arm_arch.h
+++ b/crypto/arm_arch.h
@@ -106,6 +106,7 @@ extern unsigned int OPENSSL_armv8_rsa_neonized;
 #define HISI_CPU_PART_KP920 0xD01
 #define ARM_CPU_PART_V2 0xD4F
 #define ARM_CPU_PART_N3 0xD8E
+#define ARM_CPU_PART_V3_AE 0xD83
 #define ARM_CPU_PART_V3 0xD84
 
 #define APPLE_CPU_PART_M1_ICESTORM 0x022
diff --git a/crypto/armcap.c b/crypto/armcap.c
index 8939c043a875..11ed4abb37b0 100644
--- a/crypto/armcap.c
+++ b/crypto/armcap.c
@@ -419,6 +419,7 @@ void OPENSSL_cpuid_setup(void)
             || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_MICROSOFT, MICROSOFT_CPU_PART_COBALT_100)
             || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_V2)
             || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_N3)
+            || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_V3_AE)
             || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_V3)
             || MIDR_IMPLEMENTER(OPENSSL_arm_midr) == ARM_CPU_IMP_AMPERE))
         OPENSSL_armcap_P |= ARMV8_UNROLL8_EOR3;
@@ -426,6 +427,7 @@ void OPENSSL_cpuid_setup(void)
     if ((OPENSSL_armcap_P & ARMV8_SHA3)
         && (MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_V1)
             || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_V2)
+            || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_V3_AE)
             || MIDR_IS_CPU_MODEL(OPENSSL_arm_midr, ARM_CPU_IMP_ARM, ARM_CPU_PART_V3)
             || MIDR_IMPLEMENTER(OPENSSL_arm_midr) == ARM_CPU_IMP_AMPERE))
         OPENSSL_armcap_P |= ARMV8_UNROLL12_EOR3;
