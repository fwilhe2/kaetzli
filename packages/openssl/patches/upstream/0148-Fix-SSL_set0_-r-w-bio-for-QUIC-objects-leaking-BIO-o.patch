From d1adb1e47219da3d69f1ac755b455abcbd08d031 Mon Sep 17 00:00:00 2001
From: Alexandr Nedvedicky <sashan@openssl.org>
Date: Thu, 19 Nov 2026 09:53:14 +0100
Subject: [PATCH] Fix SSL_set0_{r,w}bio() for QUIC objects leaking BIO on
 failure

SSL_set0_rbio()/SSL_set0_wbio() must always consume the supplied BIO
object, regardless success/failure of underlying set operation.

  [ Removed mention of DTLS, as the branch predates the introduction
    of the DTLS litener. ]

Resolves: https://github.com/openssl/openssl/issues/33645
Fixes: 22d53c88838d "QUIC Front-End I/O API"
Co-authored-by: Andrew Dinh <andrewd@openssl.org>
Reviewed-by: Andrew Dinh <andrewd@openssl.org>
Reviewed-by: Eugene Syromiatnikov <esyr@openssl.org>
Reviewed-by: Bob Beck <beck@openssl.org>
Merge-date: Thu Nov 26 09:41:47 2026
Merged-from: https://github.com/openssl/openssl/pull/33840
(cherry picked from commit c8c3916329edc7861f6b3e49432ea1aeafd50a61)
---
 ssl/quic/quic_impl.c | 24 ++++++++++++++++++------
 1 file changed, 18 insertions(+), 6 deletions(-)

diff --git a/ssl/quic/quic_impl.c b/ssl/quic/quic_impl.c
index edba28f6cab7..12151e2812da 100644
--- a/ssl/quic/quic_impl.c
+++ b/ssl/quic/quic_impl.c
@@ -1192,11 +1192,17 @@ void ossl_quic_conn_set0_net_rbio(SSL *s, BIO *net_rbio)
     QCTX ctx;
 
     if (!expect_quic_csl(s, &ctx))
-        return;
+        goto free;
 
-    /* Returns 0 if no change. */
+    /* Returns 0 if no change or on failure. */
     if (!quic_set0_net_rbio(ctx.obj, net_rbio))
-        return;
+        goto free;
+
+    net_rbio = NULL;
+
+free:
+    /* we are supposed to consume net_rbio */
+    BIO_free_all(net_rbio);
 }
 
 void ossl_quic_conn_set0_net_wbio(SSL *s, BIO *net_wbio)
@@ -1204,11 +1210,17 @@ void ossl_quic_conn_set0_net_wbio(SSL *s, BIO *net_wbio)
     QCTX ctx;
 
     if (!expect_quic_csl(s, &ctx))
-        return;
+        goto free;
 
-    /* Returns 0 if no change. */
+    /* Returns 0 if no change or on failure. */
     if (!quic_set0_net_wbio(ctx.obj, net_wbio))
-        return;
+        goto free;
+
+    net_wbio = NULL;
+
+free:
+    /* we are supposed to consume net_wbio */
+    BIO_free_all(net_wbio);
 }
 
 BIO *ossl_quic_conn_get_net_rbio(const SSL *s)
