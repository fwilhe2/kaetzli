From 984d41040df6fcd495b4a0a1db12c651ac9f4357 Mon Sep 17 00:00:00 2001
From: sanumesh <sanumesh@in.ibm.com>
Date: Fri, 12 Jun 2026 11:39:06 -0500
Subject: [PATCH] Address crash seen with AIX not honouring atexit registered
 routine

Reviewed-by: Tomas Mraz <tomas@openssl.foundation>
Reviewed-by: Neil Horman <nhorman@openssl.org>
Reviewed-by: Nikola Pajkovsky <nikolap@openssl.org>
Merge-date: Mon Nov 16 14:17:02 2026
Merged-from: https://github.com/openssl/openssl/pull/31486
---
 Configurations/10-main.conf | 4 ++--
 crypto/init.c               | 8 ++++++++
 2 files changed, 10 insertions(+), 2 deletions(-)

diff --git a/Configurations/10-main.conf b/Configurations/10-main.conf
index 389b4a839a92..6f4ee6d17c39 100644
--- a/Configurations/10-main.conf
+++ b/Configurations/10-main.conf
@@ -1360,8 +1360,8 @@ my %targets = (
         thread_scheme    => "pthreads",
         dso_scheme       => "dlfcn",
         shared_target    => "aix",
-        module_ldflags   => "-Wl,-G,-bsymbolic,-bnoentry",
-        shared_ldflag    => "-Wl,-G,-bsymbolic,-bnoentry",
+        module_ldflags   => "-Wl,-G,-bsymbolic,-bnoentry -binitfini::OPENSSL_cleanup",
+        shared_ldflag    => "-Wl,-G,-bsymbolic,-bnoentry -binitfini::OPENSSL_cleanup",
         shared_defflag   => "-Wl,-bE:",
         shared_fipsflag  => "-Wl,-binitfini:_init:_cleanup",
         perl_platform    => 'AIX',
diff --git a/crypto/init.c b/crypto/init.c
index 290bb0712c1e..4ebd44f28583 100644
--- a/crypto/init.c
+++ b/crypto/init.c
@@ -108,6 +108,14 @@ DEFINE_RUN_ONCE_STATIC(ossl_init_register_atexit)
     /* We use _onexit() in preference because it gets called on DLL unload */
     if (_onexit(win32atexit) == NULL)
         return 0;
+#elif defined(_AIX)
+    /*
+     * On AIX, we use -binitfini linker flag to register OPENSSL_cleanup()
+     * as the cleanup function. This is necessary because atexit() handlers
+     * registered by dynamically loaded libraries are not automatically
+     * deregistered when dlclose() is called, which can lead to crashes when
+     * the program exits and tries to call cleanup code from unmapped memory.
+     */
 #else
     if (atexit(OPENSSL_cleanup) != 0)
         return 0;
