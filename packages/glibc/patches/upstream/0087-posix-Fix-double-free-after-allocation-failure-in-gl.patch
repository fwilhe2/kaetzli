From 809fd7179d4391debd553459e58c414ef59a32c8 Mon Sep 17 00:00:00 2001
From: Adhemerval Zanella <adhemerval.zanella@linaro.org>
Date: Wed, 11 Nov 2026 15:26:05 -0300
Subject: [PATCH] posix: Fix double free after allocation failure in glob (BZ
 34993)

prefix_array prepends the directory name to each match in place.  If an
allocation fails partway through, it frees the names it has already
replaced but leaves them in the vector.  All of its callers then
release the vector with globfree, which frees those names again.

Checked on x86_64-linux-gnu.

Reviewed-by: Yury Khrustalev <yury.khrustalev@arm.com>
Tested-by: Yury Khrustalev <yury.khrustalev@arm.com>
(cherry picked from commit b21dfcc4121b9a1b46e6f3cdafa6994824ed6fb0)
---
 posix/Makefile           |   1 +
 posix/glob.c             |  25 ++++----
 posix/tst-glob-nospace.c | 125 +++++++++++++++++++++++++++++++++++++++
 3 files changed, 138 insertions(+), 13 deletions(-)
 create mode 100644 posix/tst-glob-nospace.c

diff --git a/posix/Makefile b/posix/Makefile
index e3a24c6a8515..b672f5cad413 100644
--- a/posix/Makefile
+++ b/posix/Makefile
@@ -291,6 +291,7 @@ tests := \
   tst-gai_strerror \
   tst-getopt_long1 \
   tst-glob-bz30635 \
+  tst-glob-nospace \
   tst-glob-tilde \
   tst-glob_symlinks \
   tst-gnuglob \
diff --git a/posix/glob.c b/posix/glob.c
index 17b8b90cde79..7594d41cb765 100644
--- a/posix/glob.c
+++ b/posix/glob.c
@@ -1227,7 +1227,10 @@ collated_compare (const void *a, const void *b)
 /* Prepend DIRNAME to each of N members of ARRAY, replacing ARRAY's
    elements in place.  Return nonzero if out of memory, zero if successful.
    A slash is inserted between DIRNAME and each elt of ARRAY,
-   unless DIRNAME is just "/".  Each old element of ARRAY is freed.  */
+   unless DIRNAME is just "/".  Each old element of ARRAY is freed.
+   If out of memory, ARRAY keeps the elements already replaced and the
+   original ones after them, so the caller can free all of them with
+   globfree.  */
 static int
 prefix_array (const char *dirname, char **array, size_t n)
 {
@@ -1259,20 +1262,16 @@ prefix_array (const char *dirname, char **array, size_t n)
     {
       size_t eltlen = strlen (array[i]) + 1;
       char *new = malloc (dirlen + 1 + eltlen);
-      if (new == NULL)
+      if (new != NULL)
         {
-          while (i > 0)
-            free (array[--i]);
-          return 1;
+          char *endp = mempcpy (new, dirname, dirlen);
+          *endp++ = dirsep_char;
+          mempcpy (endp, array[i], eltlen);
+          free (array[i]);
+          array[i] = new;
         }
-
-      {
-        char *endp = mempcpy (new, dirname, dirlen);
-        *endp++ = dirsep_char;
-        mempcpy (endp, array[i], eltlen);
-      }
-      free (array[i]);
-      array[i] = new;
+      else
+        return 1;
     }
 
   return 0;
diff --git a/posix/tst-glob-nospace.c b/posix/tst-glob-nospace.c
new file mode 100644
index 000000000000..1768f4f76524
--- /dev/null
+++ b/posix/tst-glob-nospace.c
@@ -0,0 +1,125 @@
+/* Test glob with injected allocation failures (BZ 34993).
+   Copyright (C) 2026 Free Software Foundation, Inc.
+   This file is part of the GNU C Library.
+
