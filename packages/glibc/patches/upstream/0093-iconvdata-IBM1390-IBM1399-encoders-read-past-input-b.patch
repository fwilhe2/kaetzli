--- a/iconvdata/Makefile
+++ b/iconvdata/Makefile
@@ -76,7 +76,7 @@ tests = bug-iconv1 bug-iconv2 tst-loading tst-e2big tst-iconv4 bug-iconv4 \
 	tst-iconv6 bug-iconv5 bug-iconv6 tst-iconv7 bug-iconv8 bug-iconv9 \
 	bug-iconv10 bug-iconv11 bug-iconv12 tst-iconv-big5-hkscs-to-2ucs4 \
 	bug-iconv13 bug-iconv14 bug-iconv15 \
-	tst-iconv-iso-2022-cn-ext tst-bug33980 \
+	tst-iconv-ibm1390 tst-iconv-iso-2022-cn-ext tst-bug33980 \
 	tst-jisx0213-progress
 ifeq ($(have-thread-library),yes)
 tests += bug-iconv3
@@ -338,6 +338,8 @@ $(objpfx)tst-bug33980.out: $(addprefix $(objpfx), $(gconv-modules)) \
 			   $(addprefix $(objpfx),$(modules.so))
 $(objpfx)tst-jisx0213-progress.out: \
   $(addprefix $(objpfx), $(gconv-modules)) $(addprefix $(objpfx),$(modules.so))
+$(objpfx)tst-iconv-ibm1390.out: $(addprefix $(objpfx), $(gconv-modules)) \
+				$(addprefix $(objpfx),$(modules.so))
 
 $(objpfx)iconv-test.out: run-iconv-test.sh \
 			 $(addprefix $(objpfx), $(gconv-modules)) \
diff --git a/iconvdata/ibm1364.c b/iconvdata/ibm1364.c
index 8df66ea04872..6b99d3b06d18 100644
--- a/iconvdata/ibm1364.c
+++ b/iconvdata/ibm1364.c
@@ -286,7 +286,7 @@ enum
     while (cmbp->res1 < ch)						      \
       ++cmbp;								      \
     /* XXX if last char is beginning of combining store in state */	      \
-    if (cmbp->res1 == ch && inptr + 4 < inend)				      \
+    if (cmbp->res1 == ch && inend - inptr >= 8)				      \
       {									      \
 	/* See if input is part of a combined character.  */		      \
 	uint32_t ch_next = get32 (inptr + 4);				      \
diff --git a/iconvdata/tst-iconv-ibm1390.c b/iconvdata/tst-iconv-ibm1390.c
new file mode 100644
index 000000000000..939588df0a30
--- /dev/null
+++ b/iconvdata/tst-iconv-ibm1390.c
@@ -0,0 +1,65 @@
