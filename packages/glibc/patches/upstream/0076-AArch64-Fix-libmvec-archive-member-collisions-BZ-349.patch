From 48fa38b9218add3a1e5c38c349a3e481a5fcf245 Mon Sep 17 00:00:00 2001
From: Pierre Blanchard <pierre.blanchard@arm.com>
Date: Wed, 11 Nov 2026 11:29:11 +0000
Subject: [PATCH] AArch64: Fix libmvec archive member collisions [BZ #34946]

Give AdvSIMD and SVE objects distinct basenames, since ar drops
directory names. Otherwise, incremental builds can overwrite members,
losing symbols and duplicating definitions.

Prefix object names with the ISA and use the generated sve_CFLAGS hook
for SVE options. The build directory stamps are no longer needed.

Fixes bug 34946 introduced in 5a60281b88a7dfd4423648fc8e1e02609219a4b6

Assisted-by: LLM
Reviewed-by: Adhemerval Zanella  <adhemerval.zanella@linaro.org>
(cherry picked from commit 30f5c72a422b271c6065eeecb941f6fa1b388e62)
---
 NEWS                         |  2 ++
 sysdeps/aarch64/fpu/Makefile | 25 ++++++++-----------------
 2 files changed, 10 insertions(+), 17 deletions(-)

diff --git a/NEWS b/NEWS
index 5445e1208dc3..6a1cdcefcc91 100644
--- a/NEWS
+++ b/NEWS
@@ -43,6 +43,8 @@ The following bugs are resolved with this release:
   [34923] math: AArch64: SVE acosh loses accuracy near 1 depending on
     other vector lanes
   [34940] math: Bug in SVE log1pf special case
+  [34946] math: AArch64: libmvec archive member collisions break
+    incremental builds
   [34966] dynamic-link: Static dlopen fail in elf/tst-ptrguard-static-
     dlopen
 
diff --git a/sysdeps/aarch64/fpu/Makefile b/sysdeps/aarch64/fpu/Makefile
index 67952cc5f225..28ef77be88b5 100644
--- a/sysdeps/aarch64/fpu/Makefile
+++ b/sysdeps/aarch64/fpu/Makefile
@@ -45,20 +45,15 @@ double-sve-funcs = $(libmvec-supported-funcs)
 mathvec-types = float double
 mathvec-subdirs = advsimd sve
 
-ifeq ($(subdir),mathvec)
-generated-dirs += $(mathvec-subdirs)
-generated += $(addsuffix /stamp,$(mathvec-subdirs))
-before-compile += $(addprefix $(objpfx),$(addsuffix /stamp,$(mathvec-subdirs)))
-
-$(addprefix $(objpfx),$(addsuffix /stamp,$(mathvec-subdirs))):
-	$(make-target-directory)
-	touch $@
-
-sysd-rules-patterns += $(foreach dir,$(mathvec-subdirs),$(dir)/%:$(dir)/%)
+# Archive members do not retain their directories, so use distinct basenames
+# for AdvSIMD and SVE objects.
+sysd-rules-patterns += $(foreach dir,$(mathvec-subdirs),\
+                        $(dir)_%:$(dir)/%)
 
+ifeq ($(subdir),mathvec)
 define libmvec-routines-for
-$(addprefix $(1)/,$(addsuffix f,$(float-$(1)-funcs))) \
-$(addprefix $(1)/,$(double-$(1)-funcs))
+$(addprefix $(1)_,$(addsuffix f,$(float-$(1)-funcs))) \
+$(addprefix $(1)_,$(double-$(1)-funcs))
 endef
 
 libmvec-vector-routines = $(foreach dir,$(mathvec-subdirs),\
@@ -128,11 +123,7 @@ $(foreach type,$(mathvec-types),\
     $(eval $(call sve-bench-cflags-template,$(type),$(f)))))
 
 # Specialize CFLAGS used for building SVE sources.
-define sve-object-cflags-template
-$(objpfx)sve/%$(1): CFLAGS += $(sve-cflags)
-endef
-
-$(foreach o,$(all-object-suffixes),$(eval $(call sve-object-cflags-template,$(o))))
+sve_CFLAGS = $(sve-cflags)
 
 CFLAGS-test-float-sve-wrappers.c = $(sve-cflags)
 CFLAGS-test-double-sve-wrappers.c = $(sve-cflags)
