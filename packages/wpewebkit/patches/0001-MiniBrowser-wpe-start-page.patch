From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Florian Wilhelm <fwilhelm.wgt@gmail.com>
Date: Fri, 6 Nov 2026 19:20:49 +0100
Subject: [PATCH] MiniBrowser (WPE): Ctrl+L opens a start page, and a switch
 for accelerated compositing

WPE's MiniBrowser has no toolbar, so nothing to type an address into. Ctrl+L
loads the page MINIBROWSER_START_PAGE names, with the current address as its
u= parameter; that page has the address field. MINIBROWSER_HARDWARE_ACCELERATION=never
sets the hardware acceleration policy to never, for a display whose only GL
is a software rasterizer.
---
 Tools/MiniBrowser/wpe/main.cpp | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/Tools/MiniBrowser/wpe/main.cpp b/Tools/MiniBrowser/wpe/main.cpp
index 035bc54..af314b2 100644
--- a/Tools/MiniBrowser/wpe/main.cpp
+++ b/Tools/MiniBrowser/wpe/main.cpp
@@ -211,6 +211,18 @@ static gboolean wpeViewEventCallback(WPEView* view, WPEEvent* event, WebKitWebVi
             return TRUE;
         }
 
+        // Ctrl+L: the start page given by MINIBROWSER_START_PAGE, which has the address
+        // field this browser has no toolbar for, with the current address in it.
+        if (keyval == WPE_KEY_l) {
+            if (const char* startPage = g_getenv("MINIBROWSER_START_PAGE")) {
+                const char* current = webkit_web_view_get_uri(webView);
+                g_autofree char* escaped = g_uri_escape_string(current ? current : "", nullptr, FALSE);
+                g_autofree char* uri = g_strconcat(startPage, "?u=", escaped, nullptr);
+                webkit_web_view_load_uri(webView, uri);
+                return TRUE;
+            }
+        }
+
         if ((modifiers & WPE_MODIFIER_KEYBOARD_SHIFT) && keyval == WPE_KEY_I) {
             webkit_web_view_toggle_inspector(webView);
             return TRUE;
@@ -654,6 +666,10 @@ static void activate(GApplication* application, gpointer)
         "display", wpeDisplay,
 #endif
         nullptr));
+    // MINIBROWSER_HARDWARE_ACCELERATION=never: no accelerated compositing, for a
+    // display whose only GL is a software one.
+    if (!g_strcmp0(g_getenv("MINIBROWSER_HARDWARE_ACCELERATION"), "never"))
+        webkit_settings_set_hardware_acceleration_policy(webkit_web_view_get_settings(webView), WEBKIT_HARDWARE_ACCELERATION_POLICY_NEVER);
     g_object_unref(settings);
     g_object_unref(defaultWebsitePolicies);
 #if ENABLE_WPE_PLATFORM_HEADLESS
