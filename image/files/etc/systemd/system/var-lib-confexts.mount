# Under Secure Boot, nothing from /var is merged as a confext: an empty read-only tmpfs
# over /var/lib/confexts before systemd-confext runs. /var is a writable disk that nothing
# verifies, and an image or directory there would merge without dm-verity, so a
# change to that disk would run code the signed UKI and the root's verity never vouched
# for (docs/guides/secure-boot.md). Extensions under Secure Boot are the attached ones,
# their tables sealed into the UKI's command line. Without Secure Boot this is skipped,
# and /var/lib/confexts merges as before (docs/guides/sysext.md).
[Unit]
Description=No unverified confexts from /var under Secure Boot
ConditionSecurity=uefi-secureboot
Before=systemd-confext.service

[Mount]
What=tmpfs
Where=/var/lib/confexts
Type=tmpfs
Options=ro,nosuid,nodev,noexec,mode=0755
