# Pinned to a Debian snapshot, for the reasons builder/Containerfile sets out at length:
# a dated base image so `debian:sid` cannot drift under an old checkout, and apt pointed
# at snapshot.debian.org so `apt-get install` resolves the same package versions it did on
# the day. Same date in both files; they are bumped together.
#
# It matters here for a reason it does not there. The builder decides what the binaries
# are compiled *by*; this image decides what the shipped bytes *are* — mkfs.erofs lays out
# the filesystem and strip decides what comes out of every ELF object. An unpinned
# erofs-utils or binutils means the same tree produces a different image, which is the one
# thing test/size-budget.txt has to be able to compare across runs.
#
# This file is the tools alone, and it is content-addressed like the builder
# (tools/image-tags.sh assembler): the builder job pushes it to the registry, and the jobs
# that assemble images pull it, so snapshot.debian.org is asked only when this file
# changes or on a FRESH run, not by every rootfs job. What changes often (the scripts,
# image/files) goes on top of it in image/Containerfile.scripts, built locally each time.
ARG SNAPSHOT=20261104
FROM debian:sid-${SNAPSHOT}@sha256:e276677157e13bc51ea5b8651f54ad28883f503cc37b3e3af2c4b6cc2f4efe7b

ARG SNAPSHOT

# binutils is here for strip: build-rootfs.sh drops the debug symbols the packages are
# compiled with, which is about half the size of the shipped tree. erofs-utils is
# mkfs.erofs, which lays out the read-only root filesystem, and cryptsetup-bin is
# veritysetup, which computes the dm-verity hash tree that seals it. libcap2-bin is
# setcap, for the two file capabilities the image grants (newuidmap, newgidmap).
# python3 runs image/sbom.py, which writes the SBOM with the standard library's json: a
# builder-side interpreter, as perl is in the builder, and nothing of it reaches a tree.
# systemd-ukify joins the kernel, its command line and our EFI stub into the unified kernel
# image (python too, and outside the tree like sbom.py); ovmf is the firmware a signed one
# is booted by under Secure Boot (tools/sign-uki.sh, which signs and enrols with the
# launcher's Go code: docs/guides/secure-boot.md).
# The retries are for snapshot.debian.org, which answers 503 under load; apt backs off
# between them.
RUN rm -f /etc/apt/sources.list.d/debian.sources /etc/apt/sources.list \
    && printf 'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/%sT000000Z sid main\n' "$SNAPSHOT" \
       > /etc/apt/sources.list \
    && printf 'Acquire::Retries "10";\n' > /etc/apt/apt.conf.d/80-retries \
    && apt-get update \
    && apt-get install -y --no-install-recommends erofs-utils cryptsetup-bin libcap2-bin binutils python3 \
       systemd-ukify ovmf \
    && rm -rf /var/lib/apt/lists/*
