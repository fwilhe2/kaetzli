# Downloaded source tarballs.
downloads

# Each package's own install tree, staging/<pkg>/, and rootfs/ merged from them all by
# tools/merge-staging.sh; plus the glibc-only sysroot CI unpacks its glibc artifact into.
staging
rootfs
sysroot
glibc-package

# The same merge, per system extension, for packages whose env.sh names one (EXTENSION=).
/extensions

# Built images, fetched CI artifacts and test console logs all land here.
output

# CI's scratch directory for downloaded artifacts.
artifacts

# Unpacked source trees, e.g. packages/bash/bash-5.3/, the directory build.sh assembles
# one in before moving it into place, and the stamp naming the patches it got.
/packages/*/*-[0-9]*/
/packages/*/.extracting/
/packages/*/.*.patches

# Local additions laid over the image by tools/build-image.sh (see the header of
# tools/build-image.sh). Never part of a CI build.
/extra

# Python: python/'s virtualenv (python/launch.py makes it from requirements.txt), and
# what Python, pytest and ruff leave beside the code.
.venv
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
